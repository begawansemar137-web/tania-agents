# ==============================================================================
# TANIA-Agents Environment Configuration
# ==============================================================================

# 1. Kunci ModelHub (LiteLLM Telkom Indonesia): https://api-modelhub.aiplayground.id
MODELHUB_API_KEY=
# Opsional: model default saat agen memakai "auto". Kosong = model pertama yang tersedia untuk kunci.
MODELHUB_DEFAULT_MODEL=
# Opsional, default https://api-modelhub.aiplayground.id/v1
MODELHUB_BASE_URL=https://api-modelhub.aiplayground.id/v1

# 2. Microsoft Entra ID (Azure AD) SSO untuk Akun @telkom.co.id
# Dapatkan dari Azure App Registration (sama seperti yang dipakai di Multica / PWD)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Tenant ID resmi Telkom Indonesia
AZURE_TENANT_ID=1e894b01-b0d3-4e42-adf7-19288728a2c7

# 3. Google Workspace OAuth SSO (Sama seperti Multica & PWD)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4. Session & Security
# Kunci rahasia untuk menandatangani cookie session (minimal 32 karakter acak)
SESSION_SECRET=your-random-32-character-secret-key-here
DATA_DIR=./data

# 5. App URL & Port
PORT=3030
APP_PORT=3030
NEXT_PUBLIC_APP_URL=http://localhost:3030
